# the web app's build (make web); .keep lets the Go embed compile before the first build
/internal/webui/dist/*
!/internal/webui/dist/.keep
/web/node_modules
# the console's build (make console), likewise
/internal/consoleui/dist/*
!/internal/consoleui/dist/.keep
/console/node_modules

# the files sandbox demo (make sandbox-files-try)
/sandbox-files-out/
/ai-connector
/ai-connector-server

# agent worktrees
/.claude/
